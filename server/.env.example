# Copy to server/.env and start with: node --env-file=.env index.js (or export these yourself).
# On EC2 the systemd service reads this file. Keep it private: chmod 600 .env

PORT=4000

# Front-end origin(s) allowed to call the API, comma-separated (no trailing slash)
CORS_ORIGIN=https://main.yourappid.amplifyapp.com

# First login, created only when the database is empty
SEED_EMAIL=demo@scenex.local
SEED_PASSWORD=change-this-password

# Cloud AI (optional). Without a key the Claude option stays disabled.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5

# Local AI: your Ollama server on a private IP. Use the GPU box's private address (same VPC, peering or VPN).
# Ollama has no login, so only the API instance may reach it (see DEPLOY.md, "Local AI server").
LOCAL_AI_URL=http://10.0.1.25:11434
LOCAL_AI_MODEL=llama3.1
